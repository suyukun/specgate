    "adr",
    "spec",
    "gate",
    "checklist",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suyukun/specgate.git"
  },
  "homepage": "https://github.com/suyukun/specgate#readme",
