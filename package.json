{
  "name": "@smashupcn/specgate",
  "version": "0.1.1",
  "description": "Stage-aware governance for repositories AI agents work in: AGENTS.md scaffold, five-doc kit, and a stage check for CI. Plain markdown, zero config, fully offline.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "specgate": "dist/cli.mjs"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "src",
    "dist",
    "templates",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES"
  ],
  "engines": {
